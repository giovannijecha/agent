{
  "schemaVersion": 3,
  "workflowPath": ".github/workflows/verify.yml",
  "workflowName": "verify",
  "jobs": [
    {
      "id": "verify-windows",
      "runner": "windows-2025",
      "timeoutMinutes": 25,
      "containmentBootstrap": false
    },
    {
      "id": "verify-linux",
      "runner": "ubuntu-24.04",
      "timeoutMinutes": 25,
      "containmentBootstrap": true
    }
  ],
  "protectedBranches": [
    "main"
  ],
  "canonicalCommands": {
    "win32": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/verify.ps1",
    "linux": "bash tools/verify.sh"
  }
}
