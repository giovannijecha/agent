  "toolSurface": {
    "tools": [
      {
        "name": "apply_patch",
        "capability": "patch-one-text-file",
        "risk": "write",
        "necessity": "Creates or updates one file through ordered exact-text hunks without broad overwrite or shell authority."
      },
      {
        "name": "list_directory",
        "capability": "enumerate-one-directory",
        "risk": "read",
        "necessity": "Discovers one directory without reading file contents or recursing."
      },
      {
        "name": "manage_path",
        "capability": "manage-one-workspace-path",
        "risk": "write",
        "necessity": "Creates one directory, moves one file or directory, or removes one file or empty directory without shell or recursive authority."
      },
      {
        "name": "read_file",
        "capability": "read-one-file",
        "risk": "read",
        "necessity": "Inspects one known file without traversing unrelated workspace paths."
      },
      {
        "name": "run_process",
        "capability": "run-one-contained-process",
        "risk": "execute",
        "necessity": "Runs one terminating structured process inside owned whole-tree containment without shell, PATH, stdin, or inherited user-environment authority."
      },
      {
        "name": "search_text",
        "capability": "search-bounded-text",
        "risk": "read",
        "necessity": "Locates exact text with bounded traversal instead of many model-directed reads."
      }
    ]
  },
