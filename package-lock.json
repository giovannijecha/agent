{
  "name": "agent-workspace",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "agent-workspace",
      "version": "0.1.0",
      "workspaces": [
        "packages/agent-core",
        "packages/agent-tools",
        "packages/agent-runtime",
        "packages/agent-provider-opencode-go",
        "packages/agent-provider-opencode-zen",
        "packages/agent-tui",
        "packages/agent-cli"
      ],
      "bin": {
        "agent": "packages/agent-cli/dist/main.js"
      },
      "engines": {
        "node": ">=22.19.0",
        "npm": "11.16.0"
      }
    },
    "node_modules/@agent/cli": {
      "resolved": "packages/agent-cli",
      "link": true
    },
    "node_modules/@agent/core": {
      "resolved": "packages/agent-core",
      "link": true
    },
    "node_modules/@agent/provider-opencode-go": {
      "resolved": "packages/agent-provider-opencode-go",
      "link": true
    },
    "node_modules/@agent/provider-opencode-zen": {
      "resolved": "packages/agent-provider-opencode-zen",
      "link": true
    },
    "node_modules/@agent/runtime": {
      "resolved": "packages/agent-runtime",
      "link": true
    },
    "node_modules/@agent/tools": {
      "resolved": "packages/agent-tools",
      "link": true
    },
    "node_modules/@agent/tui": {
      "resolved": "packages/agent-tui",
      "link": true
    },
    "packages/agent-cli": {
      "name": "@agent/cli",
      "version": "0.1.0",
      "dependencies": {
        "@agent/core": "0.1.0",
        "@agent/provider-opencode-go": "0.1.0",
        "@agent/provider-opencode-zen": "0.1.0",
        "@agent/runtime": "0.1.0",
        "@agent/tools": "0.1.0",
        "@agent/tui": "0.1.0"
      },
      "engines": {
        "node": ">=22.19.0"
      }
    },
    "packages/agent-core": {
      "name": "@agent/core",
      "version": "0.1.0",
      "engines": {
        "node": ">=22.19.0"
      }
    },
    "packages/agent-provider-opencode-go": {
      "name": "@agent/provider-opencode-go",
      "version": "0.1.0",
      "dependencies": {
        "@agent/core": "0.1.0",
        "@agent/runtime": "0.1.0",
        "@agent/tools": "0.1.0"
      },
      "engines": {
        "node": ">=22.19.0"
      }
    },
    "packages/agent-provider-opencode-zen": {
      "name": "@agent/provider-opencode-zen",
      "version": "0.1.0",
      "dependencies": {
        "@agent/core": "0.1.0",
        "@agent/runtime": "0.1.0",
        "@agent/tools": "0.1.0"
      },
      "engines": {
        "node": ">=22.19.0"
      }
    },
    "packages/agent-runtime": {
      "name": "@agent/runtime",
      "version": "0.1.0",
      "dependencies": {
        "@agent/core": "0.1.0",
        "@agent/tools": "0.1.0"
      },
      "engines": {
        "node": ">=22.19.0"
      }
    },
    "packages/agent-tools": {
      "name": "@agent/tools",
      "version": "0.1.0",
      "dependencies": {
        "@agent/core": "0.1.0"
      },
      "engines": {
        "node": ">=22.19.0"
      }
    },
    "packages/agent-tui": {
      "name": "@agent/tui",
      "version": "0.1.0",
      "engines": {
        "node": ">=22.19.0"
      }
    }
  }
}
